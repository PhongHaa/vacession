PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL (khớp với docker-compose.yml)
DATABASE_URL=postgresql://vacession:vacession@localhost:5433/vacession?schema=public

# Đổi thành chuỗi ngẫu nhiên dài khi deploy
JWT_SECRET=change-me-to-a-long-random-string

# Phí ship (VND). 0 = free ship
SHIPPING_FEE=0

# Thông tin chuyển khoản hiển thị sau khi đặt hàng
BANK_NAME=Vietcombank
BANK_ACCOUNT_NUMBER=0123456789
BANK_ACCOUNT_NAME=CONG TY VACESSION

# Thông tin shop
SHOP_EMAIL=hello@vacession.vn
SHOP_PHONE=0900000000
SHOP_ADDRESS=123 Nguyễn Trãi, Quận 1, TP.HCM
SHOP_INSTAGRAM=https://www.instagram.com/
