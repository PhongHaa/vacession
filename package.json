{
  "name": "vacession",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "setup": "npm install && npm run db:up && npm run db:migrate && npm run db:seed",
    "dev": "concurrently -n BE,FE -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:fe": "npm run dev -w frontend",
    "dev:be": "npm run dev -w backend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:studio": "npm run db:studio -w backend",
    "db:mock-images": "npm run db:mock-images -w backend",
    "demo:export": "npm run demo:export -w backend",
    "build:demo": "npm run build:demo -w frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
